{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyBridge",
  "version": "1.0.0",
  "identifier": "com.studybridge.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173/study/",
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "学习桥梁",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src *; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.png"]
  },
  "plugins": {}
}
